{
  // Typechecks the test suite and the Vitest config, which the build config
  // deliberately leaves out so they never reach `dist/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.mts"],
  "exclude": ["dist", "node_modules"]
}
