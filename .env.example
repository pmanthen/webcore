# =============================================================================
# Autonomous UX Evaluation — local environment variables
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

# PostgreSQL (Docker Compose + Prisma)
POSTGRES_USER=uxeval
POSTGRES_PASSWORD=uxeval
POSTGRES_DB=uxeval
POSTGRES_PORT=5432
# Host-side connection (apps running on the host machine)
DATABASE_URL=postgresql://uxeval:uxeval@localhost:5432/uxeval?schema=public
# In-compose connection (apps running as Docker services on ux-eval-network)
# DATABASE_URL=postgresql://uxeval:uxeval@postgres:5432/uxeval?schema=public

# Redis (Docker Compose + BullMQ)
REDIS_PORT=6379
# Host-side connection
REDIS_URL=redis://localhost:6379
# In-compose connection
# REDIS_URL=redis://redis:6379

# MinIO / object storage (Docker Compose + worker uploads + web image proxy)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host-side connection (apps running on the host machine)
MINIO_ENDPOINT=localhost
# In-compose connection: MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ux-artifacts
# Base URL used to build browsable artifact URLs. The web app proxies objects at
# /api/artifacts/<key>, so this only needs changing if you serve MinIO directly.
MINIO_PUBLIC_URL=http://localhost:9000

# Application
# Leave NODE_ENV unset here — Next.js / Node set it per command (dev vs build).

# Worker / Stagehand
# mock = sample UX issues without a browser (default)
# live = run Stagehand + Playwright against the target URL
UX_EVALUATION_MODE=mock
STAGEHAND_ENV=LOCAL
STAGEHAND_MODEL=openai/gpt-4.1-mini
STAGEHAND_VERBOSE=1
WORKER_CONCURRENCY=1
# OPENAI_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Demo tenant (web app, until auth)
DEMO_CLIENT_EMAIL=demo@uxeval.local
DEMO_CLIENT_NAME="Demo Client"
