// Prisma schema for Autonomous UX Evaluation
// Shared by apps/web (API) and apps/worker (AI agent) via @autonomous-ux/database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EvaluationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// Tenant / account that owns projects under evaluation.
/// Decoupled from Auth.js `User` — one Client may have many Users.
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]
  users    User[]

  @@map("clients")
}

/// Auth.js user identity. Always scoped to a B2B `Client` tenant.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  clientId      String    @map("client_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accounts Account[]
  sessions Session[]

  @@index([clientId])
  @@map("users")
}

/// OAuth account linked to an Auth.js user (e.g. GitHub).
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Database session row (kept for Auth.js adapter compatibility; app uses JWT).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Email magic-link / verification tokens used by Auth.js providers.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A web property (URL) submitted for autonomous UX evaluation.
model Project {
  id        String        @id @default(cuid())
  clientId  String        @map("client_id")
  name      String?
  url       String
  status    ProjectStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runs        EvaluationRun[]
  evaluations EvaluationFeedback[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

/// One autonomous audit pass (one BullMQ job) over a project's URL.
/// Holds the run-level summary that used to live on `EvaluationFeedback`.
model EvaluationRun {
  id            String              @id @default(cuid())
  projectId     String              @map("project_id")
  status        EvaluationRunStatus @default(QUEUED)
  /// Short human-readable overview of the audit.
  summary       String?
  /// Overall UX score from 0–100 when available.
  score         Float?
  /// MinIO object key for the full-page screenshot captured for this run.
  screenshotKey String?             @map("screenshot_key")
  /// Browsable URL for the run screenshot (web proxy or direct MinIO URL).
  screenshotUrl String?             @map("screenshot_url")
  /// Raw Stagehand observe()/extract() payload, kept for debugging.
  rawResponse   Json?               @map("raw_response")
  /// BullMQ job id that produced this run.
  jobId         String?             @map("job_id")
  error         String?
  startedAt     DateTime?           @map("started_at")
  finishedAt    DateTime?           @map("finished_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings EvaluationFeedback[]

  @@index([projectId])
  @@index([jobId])
  @@index([status])
  @@map("evaluation_runs")
}

/// A single actionable UX finding produced by the Stagehand audit.
/// One row per issue, so the triage dashboard can filter and sort directly in SQL.
model EvaluationFeedback {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  runId           String?  @map("run_id")
  /// 'Accessibility' | 'Cognitive Load' | 'Friction' (see IssueCategory).
  category        String
  /// 'Low' | 'Medium' | 'High' (see IssueSeverity).
  severity        String
  title           String
  description     String
  /// Concrete fix suggested by the agent.
  recommendation  String
  /// Browsable URL for the screenshot evidencing this issue.
  screenshotUrl   String?  @map("screenshot_url")
  /// MinIO object key backing `screenshotUrl`.
  screenshotKey   String?  @map("screenshot_key")
  /// CSS selector / ARIA locator of the offending element, when known.
  elementSelector String?  @map("element_selector")
  /// Page URL where the issue was observed (may differ from the project root URL).
  pageUrl         String?  @map("page_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     EvaluationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([runId])
  @@index([projectId, category])
  @@index([projectId, severity])
  @@map("evaluation_feedback")
}
