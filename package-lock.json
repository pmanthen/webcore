{
  "name": "autonomous-ux-eval",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "autonomous-ux-eval",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/web": {
      "name": "@autonomous-ux/web",
      "version": "0.1.0"
    },
    "apps/worker": {
      "name": "@autonomous-ux/worker",
      "version": "0.1.0"
    },
    "node_modules/@autonomous-ux/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@autonomous-ux/worker": {
      "resolved": "apps/worker",
      "link": true
    }
  }
}
