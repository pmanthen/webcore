# =============================================================================
# Autonomous UX Evaluation — local environment variables
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

# PostgreSQL (Docker Compose + Prisma)
POSTGRES_USER=uxeval
POSTGRES_PASSWORD=uxeval
POSTGRES_DB=uxeval
POSTGRES_PORT=5432
# Host-side connection (apps running on the host machine)
DATABASE_URL=postgresql://uxeval:uxeval@localhost:5432/uxeval?schema=public
# In-compose connection (apps running as Docker services on ux-eval-network)
# DATABASE_URL=postgresql://uxeval:uxeval@postgres:5432/uxeval?schema=public

# Redis (Docker Compose + BullMQ)
REDIS_PORT=6379
# Host-side connection
REDIS_URL=redis://localhost:6379
# In-compose connection
# REDIS_URL=redis://redis:6379

# MinIO / object storage (Docker Compose + worker uploads + web image proxy)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host-side connection (apps running on the host machine)
MINIO_ENDPOINT=localhost
# In-compose connection: MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ux-artifacts
# Base URL used to build browsable artifact URLs. The web app proxies objects at
# /api/artifacts/<key>, so this only needs changing if you serve MinIO directly.
MINIO_PUBLIC_URL=http://localhost:9000

# Application
# Leave NODE_ENV unset here — Next.js / Node set it per command (dev vs build).

# Worker / Stagehand
# mock = sample UX issues without a browser (default)
# live = run Stagehand + Playwright against the target URL
UX_EVALUATION_MODE=mock
STAGEHAND_ENV=LOCAL
STAGEHAND_MODEL=openai/gpt-4.1-mini
STAGEHAND_VERBOSE=1
WORKER_CONCURRENCY=1
# OPENAI_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Optional: OpenAI-compatible gateway instead of api.openai.com.
# Also how apps/worker/dev/mock-llm-server.mjs is wired up for offline live runs.
# STAGEHAND_MODEL_API_KEY=
# STAGEHAND_BASE_URL=http://localhost:4600/v1
# STAGEHAND_OPENAI_ENDPOINT_FORMAT=chat

# Audit tuning (live mode)
UX_VIEWPORT_WIDTH=1440
UX_VIEWPORT_HEIGHT=900
UX_NAV_TIMEOUT_MS=45000
UX_EXTRACT_TIMEOUT_MS=90000
# Cap on element crops per run, so a noisy page cannot flood object storage.
UX_MAX_ELEMENT_SCREENSHOTS=8

# Auth.js (GitHub OAuth). CI / unit tests can omit the GitHub pair.
AUTH_SECRET=replace-with-a-long-random-string
# AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
